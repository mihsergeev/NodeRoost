# --- Обязательное (панель НЕ СТАРТУЕТ на пустых/дефолтных секретах) ---

# Учётка админа: начальный вход в панель (JWT + опц. 2FA). Пароль здесь — только
# ПЕРВЫЙ; далее меняется в UI (⚙ → Сменить пароль) и из .env не пересинхронизируется.
NODEROOST_ADMIN_USER=admin
# Надёжный пароль (не "admin"/"changeme"), иначе панель не запустится:
NODEROOST_ADMIN_PASSWORD=

# Секрет подписи JWT — минимум 32 случайных символа:
#   openssl rand -hex 32
NODEROOST_JWT_SECRET=

# Сколько живёт сессия в панели (минуты). Отсчёт от ВХОДА, а не от последней
# активности: продления по мере работы нет. Токен лежит в localStorage браузера,
# отозвать досрочно можно только сменой пароля — она обнуляет все сессии сразу.
# Дефолт 720 (12 ч). 4320 = 3 суток.
NODEROOST_JWT_TTL_MINUTES=720

# Пароль PostgreSQL (только внутри compose-сети). Любое надёжное значение.
NODEROOST_DB_PASSWORD=

# Break-glass: 1 сбрасывает пароль админа (на NODEROOST_ADMIN_PASSWORD) и
# отключает 2FA при следующем старте — только если потеряны И пароль, И 2FA;
# потом верните 0 и перезапустите. В обычном режиме держите 0.
NODEROOST_ADMIN_PASSWORD_RESET=0

# --- headscale ---

# Публичный домен control-сервера headscale (ноды подключаются сюда отовсюду).
# Нужна DNS A-запись на IP сервера. server_url в config.yaml headscale должен
# совпадать: https://<этот домен>.
NODEROOST_HS_DOMAIN=hs.example.com

# Старые имена control-сервера (через пробел) на время СМЕНЫ ДОМЕНА. Нода хранит
# адрес control-сервера у себя, а агент — в /lib65/noderoost-agent/apply.sh, так
# что старое имя обязано отвечать, пока нода не переведена на новое. Убрать,
# когда переехали все ноды.
#   NODEROOST_HS_DOMAIN_ALIASES=hs.old-example.com
NODEROOST_HS_DOMAIN_ALIASES=

# Маска имён ВНУТРИ СЕТИ, для которых панель выпускает сертификаты Let's Encrypt
# (раздел «DNS» → галочка «сертификат» у имени). Нужна одна DNS-запись, один раз:
#
#   *.int.example.com   A   <IP этого сервера>
#
# Проверка Let's Encrypt приходит по 80-му порту на само имя сервиса — запись
# ведёт её сюда, а панель отвечает. Ни API-ключей DNS-хостинга, ни плагинов: у
# кого DNS-хостинг без API, схема работает так же.
#
# Пусто = сертификаты не выпускаются, имена внутри сети работают как обычно.
#   NODEROOST_CERT_DOMAIN=*.int.example.com
NODEROOST_CERT_DOMAIN=

# API-ключ управляющего REST headscale. Создаётся ОДИН раз после первого старта:
#   docker compose exec headscale headscale apikeys create --expiration 999d
# затем впишите сюда и перезапустите backend. Пусто = операции с нодами недоступны.
NODEROOST_HEADSCALE_API_KEY=

# Образ headscale (пиновать тег; проверьте актуальный стабильный при установке).
NODEROOST_HEADSCALE_IMAGE=headscale/headscale:0.29.2

# --- Edge TLS + вайтлист (compose.caddy.yml) ---

# Домен ПАНЕЛИ (edge-TLS). Панель закрыта вайтлистом (ниже).
NODEROOST_DOMAIN=panel.example.com

# Старые имена панели (через пробел) на время смены домена — чтобы закладки и
# ссылки в алертах не отвалились разом. Вайтлист у них общий с основным доменом.
NODEROOST_DOMAIN_ALIASES=

# IP/CIDR через пробел, кому разрешён доступ к ПАНЕЛИ (админка).
# ОБЯЗАТЕЛЬНО заполнить: пусто = fail-closed, панель будет закрыта ДЛЯ ВСЕХ.
# Узнать свой адрес: curl -s https://ifconfig.me
#   # С каких адресов пускать в ПАНЕЛЬ (control-сервер это не ограничивает).
# Пусто = закрыта для всех: забытая настройка не должна выставить админку наружу.
NODEROOST_ALLOW_IPS=0.0.0.0/0 ::/0 198.51.100.0/24
NODEROOST_ALLOW_IPS=203.0.113.10

# Имя внешней docker-сети caddy-docker-proxy (если не "caddy").
# ОТДЕЛЬНАЯ сеть под NodeRoost, а не общая с чужими контейнерами: соседи по
# сети достают API панели напрямую, минуя IP-вайтлист прокси (см. SECURITY.md).
# Создать: docker network create noderoost-edge
# и добавить её в CADDY_INGRESS_NETWORKS обратного прокси.
NODEROOST_CADDY_NETWORK=noderoost-edge

# Активные compose-файлы (база + caddy-override):
# compose.tls.yml — свой Caddy с автоматическими сертификатами (установка
# «всё в одном»). Уже есть обратный прокси? compose.caddy.yml — для
# caddy-docker-proxy, либо уберите оверлей и проксируйте на NODEROOST_BIND.
COMPOSE_FILE=compose.yml:compose.tls.yml

# --- Опциональное ---

# Внешний IP панели (для информации/скриптов)
NODEROOST_PANEL_IP=

# Куда публиковать панель на хосте в standalone-режиме (без caddy-override).
# По умолчанию только localhost — поставьте впереди HTTPS-прокси.
NODEROOST_BIND=127.0.0.1:8080

# Тег образов при установке из готовых GHCR-образов (docker compose pull).
# тег релиза для образов из GHCR: latest не используем — прод должен ехать
# на конкретной, проверенной сборке
NODEROOST_VERSION=0.6.0
