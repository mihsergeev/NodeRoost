# Caddy для установки «всё в одном» (compose.tls.yml): TLS-сертификаты
# получаются автоматически, панель закрыта списком адресов, управляющий API
# headscale наружу не выставлен.
#
# Значения подставляются из .env (Caddy читает переменные окружения).
# Если у вас УЖЕ есть свой обратный прокси — этот файл не нужен, см. docs/install.md.
#
# Let's Encrypt выдаёт сертификат и без почты. Хотите письмо о скором
# истечении — добавьте первой строкой блок: { email вы@example.com }

# ── Панель ────────────────────────────────────────────────────────────────
# Доступна только с адресов из NODEROOST_ALLOW_IPS (по умолчанию — отовсюду).
{$NODEROOST_DOMAIN} {
	# Пустая переменная НЕ открывает панель миру: подставится 127.0.0.1, и тогда
	# «не из 127.0.0.1» истинно для всех — панель закрыта, а control-сервер
	# продолжает работать. Забытая настройка не должна выставлять админку наружу.
	@denied not remote_ip {$NODEROOST_ALLOW_IPS:127.0.0.1}
	abort @denied
	reverse_proxy frontend:80
}

# ── Control-сервер headscale ──────────────────────────────────────────────
# Публичный: ноды подключаются откуда угодно. Наружу отдаём только то, что нужно
# клиенту Tailscale и агенту; управляющий API остаётся во внутренней сети.
{$NODEROOST_HS_DOMAIN} {
	# Управляющий API и его документация — наружу 404. Панель ходит в него
	# по внутренней сети Docker.
	handle /api/v1* {
		respond 404
	}
	handle /swagger* {
		respond 404
	}
	# Локальный мирор бинарей Tailscale: нода в закрытом меше видит только этот
	# домен, поэтому клиент качает отсюда. Раздаёт nginx фронтенда.
	handle /pkgs/* {
		reverse_proxy frontend:80
	}
	# Желаемое состояние ноды (маршруты, режим выхода) — агент забирает по токену.
	handle /agent/* {
		reverse_proxy frontend:80
	}
	# Скрипт подключения по ссылке: одна команда вместо простыни в консоли.
	handle /join/* {
		reverse_proxy frontend:80
	}
	# Сертификат CA и установщики к нему — тоже одной командой.
	handle /ca/* {
		reverse_proxy frontend:80
	}
	# Всё остальное — узловой контур headscale: регистрация, /ts2021, /derp, /health.
	handle {
		reverse_proxy headscale:8080
	}
}
