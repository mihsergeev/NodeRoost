# NodeRoost offsite: реквизиты restic rest-server. Скопируйте в offsite.env,
# впишите реальные значения и: chmod 600 /lib65/noderoost/offsite.env
# USER:PASS — htpasswd-доступ rest-server; путь /noderoost/ — отдельный репозиторий.
export RESTIC_REPOSITORY="rest:https://USER:PASS@backup.example.com/noderoost/"
export RESTIC_PASSWORD="ПРИДУМАЙТЕ_ПАРОЛЬ_ШИФРОВАНИЯ_РЕПО"
